# Supabase 프로젝트 생성 후 Project Settings > Database > Connection string 에서 복사
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.xxxxxxxxxxxx.supabase.co:5432/postgres"

# Auth.js (NextAuth) 세션 암호화용 시크릿 (openssl rand -base64 32 로 생성)
AUTH_SECRET=""

# loind-web(로인드 홈페이지)의 Supabase 프로젝트 URL과 공개(anon) 키.
# 아티즌 홈 포트폴리오에 노출할 스토리를 읽어오는 용도로만 쓰인다 (읽기 전용).
LOIND_WEB_SUPABASE_URL=""
LOIND_WEB_SUPABASE_ANON_KEY=""

# 아티즌 사이트 고객 로그인 토큰 서명용 시크릿 (openssl rand -base64 32 로 생성)
ARTISAN_CUSTOMER_JWT_SECRET=""

# 새 아티즌 의뢰 접수 알림 메일 발송용 Gmail 계정 (myaccount.google.com/apppasswords 에서 발급한 앱 비밀번호)
GMAIL_USER=""
GMAIL_APP_PASSWORD=""
ORDER_NOTIFY_FALLBACK_EMAIL=""
