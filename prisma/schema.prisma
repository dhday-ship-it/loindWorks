// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum Role {
  SUPER_ADMIN
  PM           // 프로젝트 매니저 (구 BRAND_ADMIN)
  STAFF
}

enum TaskStatus {
  WAIT         // 대기
  IN_PROGRESS  // 진행 중
  REVIEW       // 검토 요청
  FEEDBACK     // 피드백/수정 필요
  DONE         // 완료
}

enum TaskPriority {
  HIGH
  NORMAL
  LOW
}

enum ProjectStatus {
  PENDING
  IN_PROGRESS
  DONE
}

enum RequestStatus {
  WAIT
  CHECK
  WIP
  REVIEW
  DONE
}

enum LogType {
  CALL
  MEET
  MSG
  EMAIL
  NOTE
}

enum TaxType {
  VAT_EXCLUSIVE
  VAT_INCLUSIVE
  WITHHOLD_3_3
  NONE
}

enum NotificationType {
  TASK_ASSIGNED     // 작업 배정됨
  TASK_STATUS       // 작업 상태 변경
  TASK_DUE          // 마감 임박 (D-3)
  TASK_OVERDUE      // 마감 초과
  TASK_COMMENT      // 작업 댓글
  TASK_MENTION      // @멘션
  LOG_MENTION       // 스트림 기록 태그
  PROJECT_UPDATE    // 프로젝트 상태/단계 변경
}

// ─── Core Models ─────────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  passwordHash  String?
  role          Role      @default(STAFF)
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // NextAuth
  accounts Account[]
  sessions Session[]

  // 작업
  assignedTasks  Task[]         @relation("AssignedTasks")
  createdTasks   Task[]         @relation("CreatedTasks")
  taskComments   TaskComment[]

  // 알림
  notifications  Notification[]

  // 캘린더/메모
  calendarEvents CalendarEvent[]
  memoFolders    MemoFolder[]
  memos          Memo[]

  // 프로젝트
  projectMemberships ProjectMember[]
  projectRequests    ProjectRequest[]
  requestAssignments RequestAssignee[]
  activityLogs       ActivityLog[]
  projectRecords     ProjectRecord[]
  uploadedFiles      ProjectFile[]
  pmProjects         Project[]         @relation("ProjectPM")

  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
}

model Company {
  id           String   @id @default(cuid())
  name         String
  companyId    String   @unique
  contactName  String?
  contactEmail String?
  contactPhone String?
  createdAt    DateTime @default(now())

  users    User[]
  projects Project[]
}

model Project {
  id           String        @id @default(cuid())
  name         String
  status       ProjectStatus @default(PENDING)
  summary      String?
  statusNote   String?
  phases       Json
  currentPhase Int           @default(0)
  startDate    DateTime?
  endDate      DateTime?
  brandColors  String[]      @default([])
  keywords     String[]      @default([])
  notes        String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  pmId String?
  pm   User?   @relation("ProjectPM", fields: [pmId], references: [id], onDelete: SetNull)

  members        ProjectMember[]
  tasks          Task[]
  requests       ProjectRequest[]
  logs           ActivityLog[]
  calendarEvents CalendarEvent[]
  records        ProjectRecord[]
  files          ProjectFile[]
}

// ─── Task (핵심 작업 관리) ────────────────────────────────────────────────────

model Task {
  id          String       @id @default(cuid())
  title       String
  description String?
  status      TaskStatus   @default(WAIT)
  priority    TaskPriority @default(NORMAL)
  startDate   DateTime?
  dueDate     DateTime?
  order       Int          @default(0)   // 칸반 컬럼 내 순서 (drag & drop)
  archivedAt  DateTime?                  // null이면 활성, 값 있으면 아카이브
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  assigneeId String
  assignee   User   @relation("AssignedTasks", fields: [assigneeId], references: [id], onDelete: Cascade)

  createdById String
  createdBy   User   @relation("CreatedTasks", fields: [createdById], references: [id], onDelete: Cascade)

  comments      TaskComment[]
  files         ProjectFile[]
  notifications Notification[]
  // 상태 변경 자동 히스토리
  history       TaskHistory[]
}

model TaskComment {
  id        String   @id @default(cuid())
  body      String
  mentions  String[] @default([]) // 멘션된 userId 목록
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  taskId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)
}

model TaskHistory {
  id         String     @id @default(cuid())
  fromStatus TaskStatus?
  toStatus   TaskStatus?
  note       String?     // 선택적 메모
  createdAt  DateTime   @default(now())

  taskId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  actorId String
  // actor 직접 relation 없이 userId 저장 (삭제 시 히스토리 유지)
}

// ─── Notification ─────────────────────────────────────────────────────────────

model Notification {
  id        String           @id @default(cuid())
  type      NotificationType
  title     String
  body      String?
  read      Boolean          @default(false)
  link      String?          // 이동할 경로 (예: /dashboard/projects?taskId=xxx)
  createdAt DateTime         @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // 연관 작업 (선택)
  taskId String?
  task   Task?  @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

// ─── Project 하위 모델 ────────────────────────────────────────────────────────

model ProjectMember {
  id        String @id @default(cuid())
  roleLabel String

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
}

model ProjectRequest {
  id        String   @id @default(cuid())
  title     String?
  body      String
  itemType  String   @default("TASK") // "TASK" only (클라이언트 요청 제거)
  createdAt DateTime @default(now())

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  assignees RequestAssignee[]
  files     ProjectFile[]
}

model RequestAssignee {
  id       String        @id @default(cuid())
  status   RequestStatus @default(WAIT)
  comments Json          @default("[]")

  requestId String
  request   ProjectRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([requestId, userId])
}

model ActivityLog {
  id            String    @id @default(cuid())
  type          LogType
  title         String
  body          String?
  withPerson    String?
  logDate       DateTime?
  taggedUserIds String[]  @default([])
  edits         Json      @default("[]")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  files ProjectFile[]
}

model ProjectFile {
  id       String  @id @default(cuid())
  name     String
  url      String
  size     Int
  mimeType String?

  createdAt DateTime @default(now())

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  // 연결 대상 (택1)
  taskId    String?
  task      Task?          @relation(fields: [taskId], references: [id], onDelete: Cascade)

  requestId String?
  request   ProjectRequest? @relation(fields: [requestId], references: [id], onDelete: Cascade)

  logId String?
  log   ActivityLog? @relation(fields: [logId], references: [id], onDelete: Cascade)

  uploaderId String
  uploader   User   @relation(fields: [uploaderId], references: [id], onDelete: Cascade)
}

model ProjectRecord {
  id    String   @id @default(cuid())
  date  DateTime
  title String
  note  String?

  amount           Int?
  taxType          TaxType @default(VAT_INCLUSIVE)
  advancePayment   Int?
  balance          Int?
  settled          Boolean @default(false)
  taxInvoiceIssued Boolean @default(false)

  outsourced                Boolean @default(false)
  outsourceVendor           String?
  outsourceTotalAmount      Int?
  outsourceTaxType          TaxType @default(NONE)
  outsourcePayment          Int?
  outsourceBalanceSettled   Boolean @default(false)
  outsourceTaxInvoiceIssued Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)
}

// ─── Calendar & Memo ─────────────────────────────────────────────────────────

model CalendarEvent {
  id          String   @id @default(cuid())
  title       String
  startAt     DateTime
  endAt       DateTime?           // 종료 시간 추가
  allDay      Boolean  @default(false)
  color       String?             // 프로젝트별 색상 오버라이드
  description String?
  sharedWith  String[] @default([])
  createdAt   DateTime @default(now())

  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model MemoFolder {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  memos Memo[]

  @@unique([ownerId, name])
}

model Memo {
  id        String   @id @default(cuid())
  title     String
  body      String?
  pinned    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  folderId String?
  folder   MemoFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)
}

// ─── Auth.js (NextAuth) ───────────────────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
